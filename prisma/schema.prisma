generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TrackedAccount {
  id             String   @id @default(cuid())
  gameName       String
  tagLine        String
  puuid          String   @unique
  platform       String
  profileIconId  Int?
  inGame         Boolean  @default(false)
  createdAt      DateTime @default(now())
  snapshots       RankSnapshot[]
  participations  MatchParticipation[]
  analysis        PlayerAnalysis?
  predictionRounds PredictionRound[]
}

model PredictionRound {
  id          String   @id @default(cuid())
  accountId   String
  account     TrackedAccount @relation(fields: [accountId], references: [id])
  gameId      String?
  matchId     String?
  match       Match?   @relation(fields: [matchId], references: [id])
  queueType   String
  championId  Int
  messageId   String
  content     String   @default("")
  status      String   @default("open")
  result      Boolean?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
  predictions Prediction[]

  @@index([gameId, status])
  @@index([matchId])
}

model Prediction {
  id              String   @id @default(cuid())
  roundId         String
  round           PredictionRound @relation(fields: [roundId], references: [id])
  discordUserId   String
  discordUsername String
  guess           Boolean
  amount          Int      @default(0)
  createdAt       DateTime @default(now())

  @@unique([roundId, discordUserId])
}

model Bettor {
  discordUserId   String @id
  discordUsername String
  balance         Int    @default(100)
}

model PlayerAnalysis {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     TrackedAccount @relation(fields: [accountId], references: [id])
  text        String
  generatedAt DateTime @default(now())
}

model RankSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  account      TrackedAccount @relation(fields: [accountId], references: [id])
  queueType    String
  tier         String
  rank         String
  leaguePoints Int
  wins         Int
  losses       Int
  hotStreak    Boolean  @default(false)
  capturedAt   DateTime @default(now())

  @@index([accountId, queueType, capturedAt])
}

model Match {
  id               String   @id
  queueId          Int
  gameCreation     DateTime
  gameDuration     Int
  participations   MatchParticipation[]
  predictionRounds PredictionRound[]
}

model MatchParticipation {
  id           String   @id @default(cuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id])
  accountId    String
  account      TrackedAccount @relation(fields: [accountId], references: [id])
  championName String
  championId   Int
  kills        Int
  deaths       Int
  assists      Int
  win          Boolean
  teamId       Int
  doubleKills  Int      @default(0)
  tripleKills  Int      @default(0)
  quadraKills  Int      @default(0)
  pentaKills   Int      @default(0)
  epicSteals   Int      @default(0)

  @@unique([matchId, accountId])
}
